> Using Irs_2025
> Using Art_078_a

# Public composition: hand-built synthetic regression cases, not AT results

```catala
#[test]
declaration scope TesteDeclaracao0:
  output resultado content Irs_2025.Declaracao
scope TesteDeclaracao0:
  definition resultado equals output of Irs_2025.Declaracao with {
    -- ano: 2025
    -- residente: true
    -- apenas_regime_geral_a_h: true
    -- apenas_creditos_implementados: true
    -- titulares_integrais: true
    -- conjunta: false
    -- elegivel_conjunta: true
    -- separada: false
    -- monoparental: false
    -- ascendentes: 0
    -- ascendentes_partilhados: 0
    -- consignar_iva: false
    -- titulares: [Irs_2025.Titular { -- dependente: false -- bruto_a: $20000.00 -- bruto_h: $0.00 -- contribuicoes_a: $0.00 -- indemnizacoes: $0.00 -- sindicato_a: $0.00 -- ordens: $0.00 -- contribuicoes_h: $0.00 -- sindicato_h: $0.00 -- pensoes_elegiveis: true }]
    -- dependentes: []
    -- despesas: Irs_2025.Despesas { -- gerais: $1000.00 -- saude: $1000.00 -- educacao: $1000.00 -- rendas_estudante: $0.00 -- rendas: $1000.00 -- juros: $0.00 -- iva_servicos: $100.00 -- iva_transportes: $0.00 -- iva_medicamentos_veterinarios: $0.00 -- iva_publicacoes: $0.00 -- iva_desporto: $0.00 }
    -- retencoes: $2000.00
    -- pagamentos_por_conta: $0.00
  }
  assertion (resultado.rendimento_coletavel = $15,537.85 and resultado.imposto_devido = $1,524.73 and resultado.reembolso = $475.27)

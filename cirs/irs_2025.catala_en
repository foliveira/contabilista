# Ordinary resident A/H return: composition, not a new legal rule

One entry per income holder, including a zero-income spouse in joint returns.
A and H deductions are separate, but art. 70 is called ONCE per holder with
both categories' gross income and actual deductions. Household totals, filing
flags and credit-limit income are derived here, never independently supplied.

Only whole, unallocated holder incomes are supported by this integration.
`titulares_integrais` must be false for split dependent/co-owned income: those
cases need allocation AFTER annual deductions and minimum-existence assessment.
Low-level article scopes remain available for expert composition. Dependent
eligibility and household membership are caller facts; income-bearing dependents
must also appear in the family list. Include all taxpayers, even with no income.

`apenas_regime_geral_a_h` excludes other categories, exempt/excluded income,
regional/special regimes and other abatements; `apenas_creditos_implementados`
excludes credits outside 78-A–F, including regional enhancements. Expenses are
eligible, disjoint (where legally required), net and already allocated to this
return. Pension eligibility, joint-filing eligibility and monoparental status
remain caller-attested. No invoice classification is performed.
Monoparental returns are supported only above the household exclusion threshold
of art. 70: its low-level scope currently uses the ordinary €250 general-expense
limit, not the monoparental €335 limit. Low-income monoparental returns are rejected.

The literal art. 70 conflict and provisional rounding conventions are preserved.
Outputs are experimental arithmetic settlement, not filing/payment instructions.

```catala-metadata
declaration structure Titular:
  data dependente content boolean
  data bruto_a content money
  data contribuicoes_a content money
  data indemnizacoes content money
  data sindicato_a content money
  data ordens content money
  data bruto_h content money
  data contribuicoes_h content money
  data sindicato_h content money
  data pensoes_elegiveis content boolean

declaration structure Despesas:
  data gerais content money
  data saude content money
  data educacao content money
  data rendas_estudante content money
  data rendas content money
  data juros content money
  data iva_servicos content money
  data iva_transportes content money
  data iva_medicamentos_veterinarios content money
  data iva_publicacoes content money
  data iva_desporto content money

declaration structure ResultadoTitular:
  data trabalho content Art_025.DeducaoTrabalho
  data pensoes content Art_053.DeducaoPensoes
  data minimo content Art_070.MinimoExistencia

declaration scope Declaracao:
  input ano content integer
  input residente condition
  input apenas_regime_geral_a_h condition
  input apenas_creditos_implementados condition
  input titulares_integrais condition
  input conjunta condition
  input elegivel_conjunta condition
  input separada condition
  input monoparental condition
  input titulares content list of Titular
  input dependentes content list of Art_078_a.Dependente
  input ascendentes content integer
  input ascendentes_partilhados content integer
  input despesas content Despesas
  input consignar_iva condition
  input retencoes content money
  input pagamentos_por_conta content money
  internal sujeitos content integer
  internal englobamento content Art_022.Englobamento
  internal familia content Art_078_a.Familia
  internal gerais content Art_078_b.DespesasGerais
  internal saude content Art_078_c.Saude
  internal educacao content Art_078_d.Educacao
  internal imoveis content Art_078_e.Imoveis
  internal fatura content Art_078_f.Fatura
  output bruto content money
  output calculos_titulares content list of ResultadoTitular
  output abatimento content money
  output rendimento_coletavel content money
  output coleta_geral content money
  output coleta_solidariedade content money
  output iva_consignado content money
  output liquidacao content Art_078.Liquidacao
  output deducao_utilizada content money
  output imposto_devido content money
  output a_pagar content money
  output reembolso content money
```

## Specific deductions and minimum existence, then aggregation

```catala
scope Declaracao:
  assertion (ano = 2025)
  assertion residente
  assertion apenas_regime_geral_a_h
  assertion apenas_creditos_implementados
  assertion titulares_integrais
  assertion (not (conjunta and separada))
  assertion (not conjunta or elegivel_conjunta)
  assertion (not monoparental or (not conjunta and not separada and number of dependentes > 0))
  definition sujeitos equals if conjunta then 2 else 1
  assertion (number of (list of t among titulares such that not t.dependente) = sujeitos)
  assertion (number of (list of t among titulares such that t.dependente) <= number of dependentes)
  assertion (not separada or (for all d among dependentes we have d.partilhado))
  assertion (not separada or ascendentes_partilhados = ascendentes)
  definition bruto equals combine all t among titulares in total initially $0
    with total + t.bruto_a + t.bruto_h
  assertion (not monoparental or bruto > $16,093)
  definition calculos_titulares equals map each t among titulares to
    let a equals output of Art_025.DeducaoTrabalho with {
      -- ano: ano -- rendimento_bruto: t.bruto_a -- contribuicoes_obrigatorias: t.contribuicoes_a
      -- indemnizacoes_elegiveis: t.indemnizacoes -- quotizacoes_sindicais_elegiveis: t.sindicato_a
      -- quotizacoes_ordens_elegiveis: t.ordens
    } in
    let h equals output of Art_053.DeducaoPensoes with {
      -- ano: ano -- rendimento_bruto: t.bruto_h -- contribuicoes_obrigatorias: t.contribuicoes_h
      -- quotizacoes_sindicais_elegiveis: t.sindicato_h -- apenas_pensoes_elegiveis: t.pensoes_elegiveis
    } in
    ResultadoTitular { -- trabalho: a -- pensoes: h
      -- minimo: output of Art_070.MinimoExistencia with {
        -- ano: ano -- numero_sujeitos_passivos: sujeitos
        -- rendimentos_brutos_declaracao: bruto -- rendimentos_taxas_liberatorias: $0
        -- rendimento_bruto: t.bruto_a + t.bruto_h -- deducoes_especificas: a.deducao + h.deducao
        -- dependente: t.dependente -- rendimento_predominante_elegivel: true
      }
    }
  definition englobamento equals output of Art_022.Englobamento with {
    -- ano: ano -- apenas_residentes: residente -- apenas_regime_geral_a_h: apenas_regime_geral_a_h
    -- rendimentos_isentos_com_englobamento: $0
    -- titulares: map each r among calculos_titulares to Art_022.RendimentosTitular {
      -- rendimento_liquido_a: r.trabalho.rendimento_liquido
      -- rendimento_liquido_h: r.pensoes.rendimento_liquido }
  }
  definition abatimento equals combine all r among calculos_titulares in total initially $0
    with total + r.minimo.abatimento
  definition rendimento_coletavel equals englobamento.rendimento_coletavel - abatimento
  assertion (rendimento_coletavel >= $0)
```

## Rates, credits and settlement

```catala
scope Declaracao:
  definition coleta_geral equals if conjunta then
    (output of Art_069.TributacaoConjunta with {
      -- ano: ano -- opcao_tributacao_conjunta: elegivel_conjunta
      -- rendimento_coletavel: rendimento_coletavel }).imposto
    else (output of Art_068.TaxasGerais with {
      -- ano: ano -- rendimento_coletavel: rendimento_coletavel }).imposto
  definition coleta_solidariedade equals (output of Art_068_a.TaxaSolidariedade with {
    -- ano: ano -- tributacao_conjunta: conjunta -- rendimento_coletavel: rendimento_coletavel }).imposto
  definition familia equals output of Art_078_a.Familia with {
    -- ano: ano -- dependentes: dependentes -- ascendentes: ascendentes
    -- ascendentes_partilhados: ascendentes_partilhados }
  definition gerais equals output of Art_078_b.DespesasGerais with {
    -- ano: ano -- despesas_elegiveis: despesas.gerais
    -- numero_sujeitos_passivos: sujeitos -- monoparental: monoparental }
  definition saude equals output of Art_078_c.Saude with {
    -- ano: ano -- despesas_elegiveis_liquidas: despesas.saude -- separada: separada }
  definition educacao equals output of Art_078_d.Educacao with {
    -- ano: ano -- despesas_elegiveis: despesas.educacao -- rendas_estudante_elegiveis: despesas.rendas_estudante
    -- separada: separada -- apenas_regime_cirs: apenas_creditos_implementados }
  definition imoveis equals output of Art_078_e.Imoveis with {
    -- ano: ano -- rendas_elegiveis: despesas.rendas -- juros_elegiveis: despesas.juros
    -- rendimento_coletavel: rendimento_coletavel -- conjunta: conjunta -- separada: separada
    -- apenas_regime_cirs: apenas_creditos_implementados }
  definition fatura equals output of Art_078_f.Fatura with {
    -- ano: ano -- iva_servicos: despesas.iva_servicos -- iva_transportes: despesas.iva_transportes
    -- iva_medicamentos_veterinarios: despesas.iva_medicamentos_veterinarios
    -- iva_publicacoes: despesas.iva_publicacoes -- iva_desporto: despesas.iva_desporto
    -- separada: separada -- consignar: consignar_iva }
  definition iva_consignado equals fatura.consignado
  definition liquidacao equals output of Art_078.Liquidacao with {
    -- ano: ano -- residente: residente -- apenas_creditos_implementados: apenas_creditos_implementados
    -- conjunta: conjunta -- separada: separada -- rendimento_coletavel: rendimento_coletavel
    -- dependentes: number of dependentes -- coleta: coleta_geral + coleta_solidariedade
    -- descendentes_ascendentes: familia.deducao -- gerais: gerais.deducao -- saude: saude.deducao
    -- educacao: educacao.deducao -- imoveis: imoveis.deducao -- fatura: fatura.deducao
    -- retencoes: retencoes -- pagamentos_por_conta: pagamentos_por_conta }
  definition deducao_utilizada equals liquidacao.deducao_utilizada
  definition imposto_devido equals liquidacao.imposto_devido
  definition a_pagar equals liquidacao.a_pagar
  definition reembolso equals liquidacao.reembolso
```
